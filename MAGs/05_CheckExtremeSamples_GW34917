gw_pori

# --- 2. Multivariate distance of GW34917 in Pori_PC1–PC2 space ----

# use only Poribacteria ordination coordinates
pori_coords <- comb_pori %>%
  select(IID, pop, Pori_PC1, Pori_PC2)

# group-wise centroid and covariance (per population)
centers <- pori_coords %>%
  group_by(pop) %>%
  summarise(
    mean_PC1 = mean(Pori_PC1),
    mean_PC2 = mean(Pori_PC2),
    .groups = "drop"
  )

cov_list <- pori_coords %>%
  group_by(pop) %>%
  summarise(
    cov_mat = list(cov(cbind(Pori_PC1, Pori_PC2))),
    .groups = "drop"
  )

# function to compute Mahalanobis distance of one sample to its pop centroid
mahal_pop <- function(df) {
  mu  <- c(df$mean_PC1[1], df$mean_PC2[1])
  S   <- df$cov_mat[[1]]
  x   <- as.matrix(df[, c("Pori_PC1", "Pori_PC2")])
  d2  <- mahalanobis(x, center = mu, cov = S)
  sqrt(d2)
}

# merge centers and covariances back, compute distance for all samples
pori_with_dist <- pori_coords %>%
  left_join(centers, by = "pop") %>%
  left_join(cov_list, by = "pop") %>%
  rowwise() %>%
  mutate(
    dist_pop = mahal_pop(cur_data())  # distance to own pop centroid
  ) %>%
  ungroup()

pori_with_dist
# extract GW34917 distance
gw_pori_dist <- pori_with_dist %>%
  filter(IID == "GW34917") %>%
  select(IID, pop, Pori_PC1, Pori_PC2, dist_pop)

gw_pori_dist
